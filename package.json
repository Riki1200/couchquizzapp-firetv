{
  "name": "couch-quiz",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend",
    "infra"
  ],
  "packageManager": "yarn@4.5.0",
  "resolutions": {
    "js-yaml": "^3.15.1",
    "min-document": "^2.19.1",
    "logkitty": "^0.7.1",
    "node-fetch": "^2.6.7",
    "ws": "^8.21.0"
  },
  "scripts": {
    "dev": "yarn workspace @multi-tv/expo-multi-tv start",
    "dev:android": "yarn workspace @multi-tv/expo-multi-tv android",
    "dev:ios": "yarn workspace @multi-tv/expo-multi-tv ios",
    "dev:web": "yarn workspace @multi-tv/expo-multi-tv web",
    "dev:vega": "yarn workspace @multi-tv/vega start",
    "build:all": "yarn workspaces foreach -A -pt run build",
    "build:vega": "yarn workspace @multi-tv/vega run build",
    "build:vega:debug": "yarn workspace @multi-tv/vega run build:debug",
    "test:all": "yarn workspaces foreach -A -pt run test",
    "lint:all": "yarn workspaces foreach -A -pt run lint",
    "typecheck": "yarn workspaces foreach -A -pt run typecheck",
    "clean:all": "yarn workspaces foreach -A run clean && rm -rf node_modules",
    "bootstrap": "yarn install && yarn build:all",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "dev:server": "yarn workspace @couch-quiz/backend dev",
    "dev:controller": "yarn workspace @couch-quiz/controller dev",
    "play": "concurrently -k -n server,phone,tv -c yellow,magenta,cyan \"yarn dev:server\" \"yarn dev:controller\" \"EXPO_PUBLIC_HTTP_URL=http://localhost:8787 EXPO_PUBLIC_WS_URL=ws://localhost:8787 yarn dev:web\"",
    "play:aws": "concurrently -k -n phone,tv -c magenta,cyan \"yarn dev:controller\" \"EXPO_PUBLIC_HTTP_URL=https://dsl07dvuch.execute-api.us-east-1.amazonaws.com EXPO_PUBLIC_WS_URL=wss://s6wd1rjqo2.execute-api.us-east-1.amazonaws.com/prod yarn dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9",
    "esbuild": "^0.28.2",
    "husky": "^9.1.6",
    "prettier": "^3.3.3"
  }
}
